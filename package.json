{
  "name": "shadelot",
  "version": "0.1.0",
  "private": true,
  "description": "Batch, recipe and shade control for a commission textile dyehouse",
  "keywords": [
    "dyehouse",
    "textile",
    "dyeing",
    "shade-matching",
    "colorimetry",
    "liquor-ratio"
  ],
  "license": "MIT",
  "author": "glinskevxer <roym78109@gmail.com>",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "eslint": "9.19.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "vitest": "3.0.5"
  },
  "dependencies": {
    "commander": "13.1.0"
  },
  "bin": {
    "shadelot": "bin/shadelot.js"
  },
  "files": [
    "bin",
    "src"
  ]
}
